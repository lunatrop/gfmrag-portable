# gfmrag prompting-service image. Build context = repo root:
#   gcloud builds submit --config deploy/cloudbuild/serve.yaml --substitutions _IMAGE=... .
#
# CUDA *devel* base for the same reason as the extractor image: ColBERT EL
# JIT-compiles CUDA torch extensions at runtime (needs nvcc/CUDA_HOME).
FROM nvidia/cuda:12.6.3-devel-ubuntu24.04

ENV PYTHONUNBUFFERED=1 \
    POETRY_VERSION=2.4.1 \
    POETRY_VIRTUALENVS_CREATE=false \
    CUDA_HOME=/usr/local/cuda \
    HF_HOME=/models/hf

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-dev build-essential ninja-build git curl && \
    rm -rf /var/lib/apt/lists/* && \
    python3 -m venv /venv

# VIRTUAL_ENV makes poetry treat /venv as the active env (see Dockerfile).
ENV VIRTUAL_ENV=/venv \
    PATH="/venv/bin:$PATH"
RUN pip install --no-cache-dir "poetry==${POETRY_VERSION}"

WORKDIR /app

COPY pyproject.toml poetry.lock README.md ./
COPY gfmrag ./gfmrag
# GPU serving pod -> GPU faiss (use --extras faiss-cpu for a CPU-only variant).
RUN poetry install --only main --extras faiss-gpu --no-interaction --no-ansi

# Fail the BUILD (not the GPU pod) if deps didn't land in the runtime env.
RUN python -c "import numpy, torch, transformers; print('deps ok:', torch.__version__)"

# Serving deps (not in pyproject).
RUN pip install --no-cache-dir fastapi "uvicorn[standard]"

COPY deploy/serve/app.py ./app.py

EXPOSE 8000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]

# NOTE: needs GPU at runtime (Qwen3-Embedding-8B query encoding + ColBERT EL).
# The GFM GNN (8M/34M) itself is tiny. Pre-baking the GFM checkpoint into the
# image (or a GCS/PVC cache) avoids a cold HF download on every pod start.
