# Backend selector for the tuple extractor. Copy to .env.local / .env.gcp and
# `source` the one you want. The SAME LLMOPENIEModel/LLMNERModel code runs in
# both; only llm_api + endpoint differ.

# ─── LOCAL (Ollama) ─────────────────────────────────────────────────────────
# Fast iteration, no cloud cost. Default local model = qwen2.5:3b — same model
# family as the GCP vLLM backend below, and unlike gemma2:2b it produces triples
# on register-style text (see corpus-tuples/smoke-test-2026-06-10.md).
#   export GFMRAG_LLM_API=ollama
#   export GFMRAG_MODEL_NAME=qwen2.5:3b
#   export OLLAMA_HOST=127.0.0.1:11434

# ─── GCP (vLLM, OpenAI-compatible) ──────────────────────────────────────────
# Hyperscale serving. vLLM speaks the OpenAI API, so use the openai backend and
# point it at the vLLM endpoint from `terraform output vllm_openai_base_url`.
#   export GFMRAG_LLM_API=openai
#   export GFMRAG_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
#   export OPENAI_BASE_URL=http://10.x.x.x/v1      # terraform output
#   export OPENAI_API_KEY=dummy                    # vLLM ignores unless --api-key set
