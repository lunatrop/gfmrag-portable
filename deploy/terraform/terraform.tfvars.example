# Copy to terraform.tfvars and fill in. Do NOT commit the real tfvars.
project_id   = "my-gcp-project"
region       = "us-central1"
cluster_name = "gfmrag-vllm"

# 1x L4 is plenty for Qwen2.5-7B-Instruct at high throughput.
gpu_machine_type = "g2-standard-8"
gpu_type         = "nvidia-l4"
gpu_count        = 1

min_replicas = 1
max_replicas = 6

model_id      = "Qwen/Qwen2.5-7B-Instruct"
max_model_len = 8192

# Only needed for gated HF models. Prefer: export TF_VAR_hf_token=hf_xxx
# hf_token = ""

# --- Extractor workload ---
bucket_name           = "my-gfmrag-data-bucket" # must be globally unique
image_repo            = "gfmrag"
image_name            = "extractor"
image_tag             = "latest"
extractor_parallelism = 4 # parallel pods = corpus shards (data/shard-0 .. shard-3)
extractor_machine_type = "e2-standard-4"
